# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:3001,http://localhost:4200

# Database
# Copy this file to .env and replace only the placeholders. Do not commit .env.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/farm2fork?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=24h

# Payment simulator (local development only)
PAYMENT_SIMULATOR_ENABLED=true

# Fabric outbox worker. The HTTP `backend` service must keep this disabled.
# `backend-worker` overrides it to true and is the only service that receives
# the read-only crypto mount or joins the Fabric Docker network.
BLOCKCHAIN_WORKER_ENABLED=false
# Read-only Fabric access in the API process so public traces re-verify
# confirmed events on the ledger (needs the FABRIC_* identity paths below).
# If the peer is unreachable the API keeps serving and reports the check as
# unavailable.
FABRIC_READ_ENABLED=false
BLOCKCHAIN_POLL_INTERVAL_MS=5000
BLOCKCHAIN_LEASE_DURATION_MS=30000
BLOCKCHAIN_RETRY_BASE_DELAY_MS=5000
FABRIC_CHANNEL_NAME=farm2forkchannel
FABRIC_CHAINCODE_NAME=farm2fork-chaincode
FABRIC_MSP_ID=Farm2ForkMSP
FABRIC_PEER_ENDPOINT=peer0.farm2fork.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.farm2fork.com
# Required only by `docker compose ... up backend-worker`; path is host-local
# and mounted read-only at /fabric/crypto. Do not copy Fabric private keys.
FABRIC_CRYPTO_HOST_PATH=../farm2fork-blockchain/network/organizations
FABRIC_DOCKER_NETWORK=farm2fork-fabric

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Firebase Auth (Google + email/password) and FCM.
# Uses only free (Spark plan) Firebase features. Sending FCM is done from this
# backend via the Admin SDK - do NOT use Cloud Functions (that needs Blaze).
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=farm2fork-2a5b9
# The Admin SDK service-account JSON is a SECRET. Keep it OUTSIDE the repo and
# point to it by absolute path (this file is git-ignored regardless):
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/farm2fork-adminsdk.json
# ...or provide an explicit path, or inline the JSON (handy for containers/CI):
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/farm2fork-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Privileged roles are never self-assignable; allowlist their emails here.
ADMIN_EMAIL_ALLOWLIST=
FINANCIAL_PARTNER_EMAIL_ALLOWLIST=

# Firebase web session (HTTP-only cookie) + CSRF/origin protection.
# CORS_ORIGIN must be explicit (no "*") because web session cookies are credentialed.
WEB_APP_ORIGIN=http://localhost:3001
# Origin encoded in product QR codes (the web app's public /trace/:id page).
# Defaults to WEB_APP_ORIGIN when unset.
PUBLIC_TRACE_ORIGIN=http://localhost:3001
WEB_SESSION_TTL_SECONDS=86400
WEB_SESSION_COOKIE_NAME=f2f_session
# Set false only for local HTTP development; true (Secure cookie) in production.
WEB_SESSION_COOKIE_SECURE=true

# Per-IP request budget per minute (tighter limits apply to public trace, QR,
# auth and AI routes). Set TRUST_PROXY (e.g. 1) when running behind nginx so
# limits apply per real client instead of per proxy.
RATE_LIMIT_PER_MINUTE=300
TRUST_PROXY=

# farm2fork-ai FastAPI service (quality grading + price suggestions).
# On the Docker network use http://f2f-fastapi:8000. When AI_SERVICE_TOKEN is
# set, the AI service must be started with the same value.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=20000

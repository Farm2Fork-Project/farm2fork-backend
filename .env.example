# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:3001,http://localhost:4200

# Database
# Copy this file to .env and replace only the placeholders. Do not commit .env.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/farm2fork?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=24h

# Payment simulator (local development only)
PAYMENT_SIMULATOR_ENABLED=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Firebase Auth (Google + email/password) and FCM.
# Uses only free (Spark plan) Firebase features. Sending FCM is done from this
# backend via the Admin SDK - do NOT use Cloud Functions (that needs Blaze).
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=farm2fork-2a5b9
# The Admin SDK service-account JSON is a SECRET. Keep it OUTSIDE the repo and
# point to it by absolute path (this file is git-ignored regardless):
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/farm2fork-adminsdk.json
# ...or provide an explicit path, or inline the JSON (handy for containers/CI):
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/farm2fork-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Privileged roles are never self-assignable; allowlist their emails here.
ADMIN_EMAIL_ALLOWLIST=
FINANCIAL_PARTNER_EMAIL_ALLOWLIST=

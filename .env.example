# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:3001,http://localhost:4200

# Database
# Copy this file to .env and replace only the placeholders. Do not commit .env.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/farm2fork?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=24h

# Payment simulator (local development only)
PAYMENT_SIMULATOR_ENABLED=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
